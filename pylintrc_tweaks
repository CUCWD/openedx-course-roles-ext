# pylintrc tweaks for use with edx_lint.
[MASTER]
ignore = migrations
load-plugins = edx_lint.pylint,pylint_django,pylint_celery

[MESSAGES CONTROL]
disable+=
    invalid-name,
    django-not-configured,
    consider-using-with,
    bad-option-value,

[TYPECHECK]
# These modules are provided by the host edx-platform checkout.
ignored-modules=common,openedx,xmodule
